<div class="container" style="max-width:800px; padding:60px 20px 80px;">
  <h1 style="font-size:2rem;font-weight:700;color:#7B5EA7;margin-bottom:8px;">Hilfe & Kontakt</h1>
  <p style="color:#6b6b6b;margin-bottom:40px;">Wir sind für dich da – Mo–Fr von 9–17 Uhr. Antwort innerhalb von 24 Stunden.</p>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:40px;">
    <div style="background:#f5f3f8;border-radius:12px;padding:24px;">
      <div style="font-size:2rem;margin-bottom:12px;">✉️</div>
      <h3 style="font-weight:700;margin-bottom:8px;">E-Mail</h3>
      <p style="font-size:0.875rem;color:#6b6b6b;">support@{{ shop.domain }}</p>
    </div>
    <div style="background:#f5f3f8;border-radius:12px;padding:24px;">
      <div style="font-size:2rem;margin-bottom:12px;">🔁</div>
      <h3 style="font-weight:700;margin-bottom:8px;">Rückgabe & Widerruf</h3>
      <p style="font-size:0.875rem;color:#6b6b6b;">100 Tage Rückgaberecht. <a href="/pages/widerruf">Widerrufsformular →</a></p>
    </div>
  </div>

  <h2 style="font-size:1.3rem;font-weight:700;margin-bottom:20px;">Schreib uns</h2>

  {% form 'contact' %}
    {% if form.posted_successfully? %}
      <div style="background:#f0fff4;border:1px solid #9ae6b4;border-radius:8px;padding:16px;margin-bottom:16px;color:#276749;">
        ✓ Deine Nachricht wurde erfolgreich übermittelt. Wir melden uns bald!
      </div>
    {% endif %}
    {% if form.errors %}
      <div style="background:#fff5f5;border:1px solid #fc8181;border-radius:8px;padding:16px;margin-bottom:16px;color:#c53030;">
        {{ form.errors | default_errors }}
      </div>
    {% endif %}
    <div class="form-row">
      <label for="contact-name">Name *</label>
      <input type="text" id="contact-name" name="contact[name]" required class="form-input" placeholder="Dein Name" value="{{ form.name }}">
    </div>
    <div class="form-row">
      <label for="contact-email">E-Mail *</label>
      <input type="email" id="contact-email" name="contact[email]" required class="form-input" placeholder="deine@email.de" value="{{ form.email }}">
    </div>
    <div class="form-row">
      <label for="contact-subject">Betreff</label>
      <input type="text" id="contact-subject" name="contact[subject]" class="form-input" placeholder="Womit können wir dir helfen?">
    </div>
    <div class="form-row">
      <label for="contact-message">Nachricht *</label>
      <textarea id="contact-message" name="contact[body]" required class="form-textarea" rows="5" placeholder="Deine Nachricht...">{{ form.body }}</textarea>
    </div>
    <button type="submit" class="btn btn--primary">Nachricht senden</button>
  {% endform %}
</div>
