<footer class="footer">
  <div class="footer__top">
    <div class="footer__inner container">

      <div class="footer__col">
        <div class="footer__logo">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | img_url: '160x' }}" alt="{{ shop.name }}" width="160" height="auto" style="height:36px;width:auto;filter:brightness(0) invert(1)">
          {% else %}
            <img src="{{ 'lumera-logo.png' | asset_url }}" alt="LUMÉRA" width="200" height="auto" style="height:56px;width:auto;max-width:200px;filter:brightness(0) invert(1)">
          {% endif %}
        </div>
        <p class="footer__desc">{{ section.settings.description | default: 'Hochwertige Kompressionsleggings für dein Wohlbefinden und deine Fitness.' }}</p>
        <div class="footer__newsletter">
          <p><strong>Newsletter abonnieren</strong></p>
          <p class="footer__newsletter-sub">Exklusive Deals und Neuheiten direkt in dein Postfach.</p>
          <form action="/contact#contact_form" method="post" class="footer__newsletter-form">
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="utf8" value="✓">
            <div class="footer__newsletter-input-wrap">
              <input type="email" name="contact[email]" placeholder="E-Mail-Adresse" class="footer__newsletter-input" required aria-label="E-Mail-Adresse">
              <button type="submit" class="btn btn--primary footer__newsletter-btn">Registrieren</button>
            </div>
          </form>
        </div>
      </div>

      <div class="footer__col">
        <h4 class="footer__col-title">Informationen</h4>
        <ul class="footer__links">
          <li><a href="/">Startseite</a></li>
          <li><a href="/collections/leggings">Kompressionsleggings</a></li>
          <li><a href="/collections/shorts">Kompressionsshorts</a></li>
          <li><a href="/pages/ueber-uns">Über uns</a></li>
          <li><a href="/pages/faq">Häufig gestellte Fragen</a></li>
          <li><a href="/pages/kontakt">Hilfe & Kontakt</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__col-title">Rechtliche Angaben</h4>
        <ul class="footer__links">
          <li><a href="/pages/versand">Versandinformationen</a></li>
          <li><a href="/pages/widerruf">Widerrufsbelehrung</a></li>
          <li><a href="/pages/agb">Allgemeine Geschäftsbedingungen</a></li>
          <li><a href="/pages/datenschutz">Datenschutzerklärung</a></li>
          <li><a href="/pages/impressum">Impressum</a></li>
          <li><a href="/pages/cookies">Cookie-Einstellungen</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__col-title">Zahlung & Versand</h4>
        <div class="footer__payment-icons">
          <img src="{{ 'payment-visa.svg' | asset_url }}" alt="Visa" width="38" height="24" loading="lazy">
          <img src="{{ 'payment-mastercard.svg' | asset_url }}" alt="Mastercard" width="38" height="24" loading="lazy">
          <img src="{{ 'payment-paypal.svg' | asset_url }}" alt="PayPal" width="38" height="24" loading="lazy">
          <img src="{{ 'payment-klarna.svg' | asset_url }}" alt="Klarna" width="38" height="24" loading="lazy">
          <img src="{{ 'payment-amex.svg' | asset_url }}" alt="American Express" width="38" height="24" loading="lazy">
        </div>
        <p class="footer__payment-note">Alle Preise inkl. 19% MwSt. zzgl. Versandkosten.</p>
        <div class="footer__contact">
          <h4 class="footer__col-title" style="margin-top:1.5rem;">Kundenservice</h4>
          <p>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <a href="mailto:support@{{ shop.domain }}">support@{{ shop.domain }}</a>
          </p>
          <p class="footer__response-time">Mo–Fr, 9–17 Uhr | Antwort innerhalb von 24 Std.</p>
        </div>
      </div>

    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Alle Rechte vorbehalten.</p>
      <ul class="footer__bottom-links">
        <li><a href="/pages/datenschutz">Datenschutz</a></li>
        <li><a href="/pages/agb">AGB</a></li>
        <li><a href="/pages/widerruf">Widerrufsrecht</a></li>
        <li><a href="/pages/impressum">Impressum</a></li>
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Beschreibung",
      "default": "Hochwertige Kompressionsleggings für dein Wohlbefinden und deine Fitness."
    }
  ]
}
{% endschema %}
