<div class="collection-page container">
  <div class="collection-page__header">
    <h1 class="collection-page__title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="collection-page__description">{{ collection.description }}</div>
    {% endif %}
    <p class="collection-page__count">{{ collection.products_count }} Produkte</p>
  </div>

  <div class="product-grid">
    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% else %}
      <p>Keine Produkte in dieser Kollektion.</p>
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
    <div class="pagination">
      {{ paginate | default_pagination | replace: '&laquo; Previous', '← Zurück' | replace: 'Next &raquo;', 'Weiter →' }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Kollektionsseite",
  "settings": []
}
{% endschema %}
