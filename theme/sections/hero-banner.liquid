{% if section.settings.image != blank %}
<section class="hero" style="background-image: url('{{ section.settings.image | img_url: '2000x' }}');">
{% else %}
<section class="hero hero--default">
{% endif %}
  <div class="hero__inner container">
    <div class="hero__content">
      {% if section.settings.subheading != blank %}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="hero__text">{{ section.settings.text }}</p>
      {% endif %}
      <div class="hero__buttons">
        {% if section.settings.btn1_label != blank %}
          <a href="{{ section.settings.btn1_link }}" class="btn btn--primary btn--large">{{ section.settings.btn1_label }}</a>
        {% endif %}
        {% if section.settings.btn2_label != blank %}
          <a href="{{ section.settings.btn2_link }}" class="btn btn--outline btn--large">{{ section.settings.btn2_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hintergrundbild"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterüberschrift",
      "default": "SculptFit Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Die Nr. 1 für dein Wohlgefühl"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Glattere Haut, bessere Durchblutung & mehr Leichtigkeit im Alltag – für ein starkes Körpergefühl in jedem Alter."
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 Text",
      "default": "Jetzt entdecken"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 Text",
      "default": "Mehr erfahren"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
