{% if section.settings.heading != blank %}
<div class="section-heading container">
  <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
  {% if section.settings.subheading != blank %}
    <p class="section-heading__sub">{{ section.settings.subheading }}</p>
  {% endif %}
</div>
{% endif %}

<div class="product-grid container">
  {% assign collection = collections[section.settings.collection] %}
  {% if collection != blank and collection.products_count > 0 %}
    {% for product in collection.products limit: section.settings.products_limit %}
      {% render 'product-card', product: product %}
    {% endfor %}
  {% else %}
    {% for i in (1..4) %}
      <div class="product-card product-card--placeholder">
        <div class="product-card__image-wrap">
          {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__placeholder' }}
        </div>
        <div class="product-card__info">
          <h3 class="product-card__title">SculptFit 3D Kompressionsleggings</h3>
          <div class="product-card__price">
            <span class="product-card__price--compare">59,99&nbsp;€</span>
            <span class="product-card__price--current">39,99&nbsp;€</span>
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</div>

{% if section.settings.show_view_all and section.settings.collection != blank %}
  <div class="section-cta container">
    <a href="{{ collections[section.settings.collection].url }}" class="btn btn--secondary">Alle anzeigen</a>
  </div>
{% endif %}

{% schema %}
{
  "name": "Produktraster",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "SculptFit Collection!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterüberschrift"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kollektion"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Anzahl Produkte",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "\"Alle anzeigen\" anzeigen",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Produktraster"
    }
  ]
}
{% endschema %}
